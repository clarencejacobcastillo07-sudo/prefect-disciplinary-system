# Supabase API Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database Configuration (Supabase PostgreSQL only)
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your_db_password_here


# Semaphore SMS Configuration
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=STAGNES

# Application Settings
APP_NAME="St. Agnes Academy"
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost/prefect-disciplinary-system/frontend

# CORS — Comma-separated list of allowed origins. Wildcards (*) are NOT supported.
# Example: http://localhost,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost,http://localhost/prefect-disciplinary-system/frontend
